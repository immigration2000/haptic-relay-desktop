NODE_ENV=production
HAPTIC_RELAY_PORT=4174
HAPTIC_RELAY_HOST=127.0.0.1
HAPTIC_PUBLIC_RELAY_URL=https://replace-with-your-tunnel.example.com
HAPTIC_RELAY_NODE_ID=android-demo-1
HAPTIC_CONTROL_TOKEN_SECRET=replace-with-64-character-random-secret
HAPTIC_ROOM_REGISTRY_DRIVER=memory
HAPTIC_MAX_VIEWERS_PER_ROOM=50
HAPTIC_RELAY_MAX_HZ=30
HAPTIC_RELAY_BURST_FRAMES=10
HAPTIC_HOST_RECONNECT_GRACE_MS=15000
HAPTIC_RELAY_CORS_ORIGIN=*
# Leave unset to keep /metrics disabled.
# HAPTIC_METRICS_TOKEN=replace-with-a-separate-32-character-random-secret
HAPTIC_CONTROL_RATE_WINDOW_MS=60000
HAPTIC_ROOM_CREATE_RATE_LIMIT=10
HAPTIC_ROOM_JOIN_RATE_LIMIT=300
HAPTIC_TRUST_CF_CONNECTING_IP=true
